{
  "name": "urlshortner-next-redis",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:docker": "npm run prisma:docker && npm run dev",
    "prisma:docker": "cd packages/db && npx prisma migrate dev"
  },
  "devDependencies": {
    "@types/open-graph": "^0.2.5",
    "prettier": "^3.2.5",
    "turbo": "^2.1.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "ioredis": "^5.4.1",
    "node-fetch": "^3.3.2",
    "open-graph": "^0.2.6",
    "open-graph-scraper": "^6.8.4"
  }
}
